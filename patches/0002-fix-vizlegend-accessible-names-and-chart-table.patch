From cc081f219448712ea980c7548a7b17e887d5387c Mon Sep 17 00:00:00 2001
From: Dev Mehta <devmehta060505@gmail.com>
Date: Wed, 4 Nov 2026 22:33:48 +0530
Subject: [PATCH] fix(VizLegend): preserve series name in accessible name and
 align toggle state

Signed-off-by: Dev Mehta <devmehta060505@gmail.com>
---
 .../src/components/VizLegend/VizLegendListItem.tsx          | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/packages/grafana-ui/src/components/VizLegend/VizLegendListItem.tsx b/packages/grafana-ui/src/components/VizLegend/VizLegendListItem.tsx
index 4a7acdf8..3fa32a4f 100644
--- a/packages/grafana-ui/src/components/VizLegend/VizLegendListItem.tsx
+++ b/packages/grafana-ui/src/components/VizLegend/VizLegendListItem.tsx
@@ -70,8 +70,11 @@ export const VizLegendListItem = <T = unknown,>({
   );
 
   const getAriaLabel = () => {
+    if (item.disabled) {
+      return item.label;
+    }
     if (allItemsSelected) {
-      return t('grafana-ui.viz-legend.all-series-selected', 'All series selected');
+      return `${item.label}, ${t('grafana-ui.viz-legend.all-series-selected', 'All series selected')}`;
     }
     return t('grafana-ui.viz-legend.only-this-series-selected', 'Only {{label}} selected', { label: item.label });
   };
@@ -92,6 +95,7 @@ export const VizLegendListItem = <T = unknown,>({
         disabled={readonly}
         type="button"
         aria-label={getAriaLabel()}
+        aria-pressed={!item.disabled}
         onBlur={onMouseOut}
         onFocus={onMouseOver}
         onMouseOver={onMouseOver}
-- 
